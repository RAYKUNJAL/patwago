# Existing PatWaGo translator/concierge provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Reuse the original production PatWaGo Gemini translator when the key lives only on the existing API service.
LEGACY_TRANSLATE_URL=https://patwago.com/api/translate

# Itinerary reasoning + expressive/custom Jamaican voice
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
XAI_VOICE_ID=castor
XAI_VOICE_SPEED=0.96

# Optional self-hosted STT
WHISPER_URL=http://127.0.0.1:8969
WHISPER_MODEL=Systran/faster-whisper-small

# Optional Chatterbox voice-clone server fallback
TTS_BASE_URL=
TTS_MODEL=chatterbox
TTS_VOICE=jamaican-concierge

# Private owner analytics and PostgreSQL event store
ADMIN_ANALYTICS_TOKEN=
DATABASE_URL=
DATABASE_SSL=false

# Apple In-App Purchase verification for the native iOS app's Day/Trip
# passes (see ios/PatWaGoApp, lib/appstore.js, NATIVE_APP.md). Required only
# once the native app exists — /api/appstore/verify-purchase fails closed
# (503) without these. Never fetched automatically; download and verify the
# fingerprint yourself from https://www.apple.com/certificateauthority/.
APPSTORE_ROOT_CA_PEM=
APPSTORE_BUNDLE_ID=com.patwago.app
